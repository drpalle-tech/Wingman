{
  "openapi": "3.1.0",
  "info": {
    "title": "Wingman API",
    "description": "Code review and generation for developers, plus document Q&A",
    "version": "2.0.0"
  },
  "paths": {
    "/v1/review": {
      "post": {
        "tags": [
          "assist"
        ],
        "summary": "Review",
        "operationId": "review_v1_review_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/generate": {
      "post": {
        "tags": [
          "assist"
        ],
        "summary": "Generate",
        "operationId": "generate_v1_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Server-sent events: `start` {model, secrets_redacted}, then `delta` {text} chunks, then `done` (StreamDone) or `error` {message}.",
            "content": {
              "text/event-stream": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamDone"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/chat": {
      "post": {
        "tags": [
          "assist"
        ],
        "summary": "Chat",
        "operationId": "chat_v1_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CodeChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Server-sent events: `start` {model, secrets_redacted}, then `delta` {text} chunks, then `done` (StreamDone) or `error` {message}.",
            "content": {
              "text/event-stream": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamDone"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthCheck"
                }
              }
            }
          }
        }
      }
    },
    "/chat": {
      "post": {
        "summary": "Chat",
        "description": "Answers a question, grounded in uploaded documents when any match.",
        "operationId": "chat_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/upload": {
      "post": {
        "summary": "Upload Document",
        "description": "Uploads a PDF, then chunks and indexes it for document Q&A.",
        "operationId": "upload_document_upload_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_document_upload_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/documents": {
      "get": {
        "summary": "List Documents",
        "operationId": "list_documents_documents_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/documents/{document_name}": {
      "delete": {
        "summary": "Delete Document",
        "operationId": "delete_document_documents__document_name__delete",
        "parameters": [
          {
            "name": "document_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Document Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/usage": {
      "get": {
        "summary": "Get Usage",
        "operationId": "get_usage_usage_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/usage/history": {
      "get": {
        "summary": "Get Usage History",
        "operationId": "get_usage_history_usage_history_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/usage/report": {
      "get": {
        "summary": "Get Usage Report",
        "operationId": "get_usage_report_usage_report_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/usage/reset": {
      "post": {
        "summary": "Reset Usage",
        "operationId": "reset_usage_usage_reset_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_upload_document_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_document_upload_post"
      },
      "ChatRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "response": {
            "type": "string",
            "title": "Response"
          },
          "sources": {
            "items": {},
            "type": "array",
            "title": "Sources"
          },
          "conversation_id": {
            "type": "string",
            "title": "Conversation Id"
          },
          "cost": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost"
          }
        },
        "type": "object",
        "required": [
          "response",
          "sources",
          "conversation_id"
        ],
        "title": "ChatResponse"
      },
      "ChatTurn": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 200000,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatTurn"
      },
      "CodeChatRequest": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatTurn"
            },
            "type": "array",
            "maxItems": 60,
            "minItems": 1,
            "title": "Messages",
            "description": "Conversation so far, oldest first"
          },
          "context": {
            "$ref": "#/components/schemas/ContextBundle"
          }
        },
        "type": "object",
        "required": [
          "messages"
        ],
        "title": "CodeChatRequest"
      },
      "ContextBundle": {
        "properties": {
          "files": {
            "items": {
              "$ref": "#/components/schemas/ContextFile"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Files"
          },
          "selection": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Selection"
              },
              {
                "type": "null"
              }
            ]
          },
          "project": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProjectInfo"
              },
              {
                "type": "null"
              }
            ],
            "description": "Facts the client already knows; merged with detection"
          },
          "diagnostics": {
            "items": {
              "$ref": "#/components/schemas/Diagnostic"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Diagnostics"
          }
        },
        "type": "object",
        "title": "ContextBundle"
      },
      "ContextFile": {
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Path"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language",
            "description": "Overrides detection from the file extension"
          },
          "role": {
            "type": "string",
            "enum": [
              "target",
              "related",
              "config"
            ],
            "title": "Role",
            "description": "target: code to review/change; related: supporting code; config: manifests and tool configs",
            "default": "target"
          }
        },
        "type": "object",
        "required": [
          "path",
          "content"
        ],
        "title": "ContextFile"
      },
      "Diagnostic": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "line": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Line"
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "info",
              "hint"
            ],
            "title": "Severity",
            "default": "warning"
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "title": "Message"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          }
        },
        "type": "object",
        "required": [
          "path",
          "line",
          "message"
        ],
        "title": "Diagnostic"
      },
      "Finding": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "major",
              "minor",
              "info"
            ],
            "title": "Severity"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "start_line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Line"
          },
          "end_line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Line"
          },
          "anchored": {
            "type": "boolean",
            "title": "Anchored",
            "description": "True when the location was verified against the source"
          },
          "quote": {
            "type": "string",
            "title": "Quote",
            "default": ""
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "suggestion": {
            "type": "string",
            "title": "Suggestion",
            "default": ""
          },
          "suggested_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suggested Code"
          },
          "source": {
            "type": "string",
            "enum": [
              "model",
              "secret-scan"
            ],
            "title": "Source",
            "default": "model"
          }
        },
        "type": "object",
        "required": [
          "id",
          "severity",
          "category",
          "path",
          "anchored",
          "title",
          "message"
        ],
        "title": "Finding"
      },
      "Framework": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Framework"
      },
      "GenerateRequest": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "new",
              "complete",
              "refactor"
            ],
            "title": "Mode"
          },
          "request": {
            "type": "string",
            "maxLength": 8000,
            "title": "Request",
            "default": ""
          },
          "context": {
            "$ref": "#/components/schemas/ContextBundle"
          }
        },
        "type": "object",
        "required": [
          "mode"
        ],
        "title": "GenerateRequest"
      },
      "GeneratedFile": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "path",
          "language",
          "content"
        ],
        "title": "GeneratedFile"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthCheck": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "documents_enabled": {
            "type": "boolean",
            "title": "Documents Enabled"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "model",
          "documents_enabled"
        ],
        "title": "HealthCheck"
      },
      "ProjectInfo": {
        "properties": {
          "languages": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Languages"
          },
          "frameworks": {
            "items": {
              "$ref": "#/components/schemas/Framework"
            },
            "type": "array",
            "title": "Frameworks"
          },
          "runtime": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Runtime"
          }
        },
        "type": "object",
        "title": "ProjectInfo"
      },
      "ReviewRequest": {
        "properties": {
          "context": {
            "$ref": "#/components/schemas/ContextBundle"
          },
          "focus": {
            "items": {
              "type": "string",
              "enum": [
                "correctness",
                "security",
                "leaks",
                "performance",
                "concurrency",
                "error-handling",
                "design",
                "maintainability",
                "testing"
              ]
            },
            "type": "array",
            "title": "Focus",
            "description": "Empty means all areas"
          },
          "instructions": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ],
            "title": "Instructions"
          }
        },
        "type": "object",
        "required": [
          "context"
        ],
        "title": "ReviewRequest"
      },
      "ReviewResponse": {
        "properties": {
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array",
            "title": "Findings"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "usage": {
            "$ref": "#/components/schemas/UsageInfo"
          }
        },
        "type": "object",
        "required": [
          "summary",
          "findings",
          "model",
          "usage"
        ],
        "title": "ReviewResponse"
      },
      "Selection": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "start_line": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Start Line"
          },
          "end_line": {
            "type": "integer",
            "minimum": 1.0,
            "title": "End Line"
          }
        },
        "type": "object",
        "required": [
          "path",
          "start_line",
          "end_line"
        ],
        "title": "Selection"
      },
      "StreamDone": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "files": {
            "items": {
              "$ref": "#/components/schemas/GeneratedFile"
            },
            "type": "array",
            "title": "Files"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated"
          },
          "secrets_redacted": {
            "type": "integer",
            "title": "Secrets Redacted"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "usage": {
            "$ref": "#/components/schemas/UsageInfo"
          }
        },
        "type": "object",
        "required": [
          "text",
          "files",
          "truncated",
          "secrets_redacted",
          "model",
          "usage"
        ],
        "title": "StreamDone",
        "description": "Payload of the final `done` server-sent event from /v1/generate and /v1/chat."
      },
      "UsageInfo": {
        "properties": {
          "input_tokens": {
            "type": "integer",
            "title": "Input Tokens"
          },
          "output_tokens": {
            "type": "integer",
            "title": "Output Tokens"
          },
          "total_tokens": {
            "type": "integer",
            "title": "Total Tokens"
          },
          "cost_usd": {
            "type": "number",
            "title": "Cost Usd"
          }
        },
        "type": "object",
        "required": [
          "input_tokens",
          "output_tokens",
          "total_tokens",
          "cost_usd"
        ],
        "title": "UsageInfo"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}

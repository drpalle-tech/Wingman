# Azure OpenAI (required)
# Resource endpoint only, not the full /chat/completions URL
AZURE_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_API_KEY=your-api-key-here
DEPLOYMENT_NAME=gpt-5-mini

# Optional model settings
# LLM_MODEL=gpt-5-mini              # model name for capabilities/pricing if it differs from DEPLOYMENT_NAME
# AZURE_API_VERSION=2025-04-01-preview
# LLM_REASONING_EFFORT=medium       # minimal | low | medium | high (reasoning models only)
# MAX_CONTEXT_CHARS=400000

# Server (defaults shown)
# HOST=127.0.0.1
PORT=8000
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development

# Document Q&A (optional; leave unset to disable)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_CONTAINER=documents
SEARCH_ENDPOINT=https://copilot-search.search.windows.net
SEARCH_ADMIN_KEY=your-search-admin-key-here
SEARCH_INDEX_NAME=copilot-documents
